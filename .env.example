# Polymarket Configuration
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYGON_PRIVATE_KEY=your_polygon_wallet_private_key_here
POLYGON_RPC_URL=https://polygon-rpc.com

# Exchange API Keys (read-only for price feeds)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Bot Configuration
MIN_PROFIT_THRESHOLD_CENTS=2
MAX_POSITION_SIZE_USDC=100
POLL_INTERVAL_MS=1000
DRY_RUN=true
# Optional: initial BTC 5-min event slug to track (and subsequent windows). Example: btc-updown-5m-1771026600
# POLYMARKET_BTC_5M_EVENT_SLUG=btc-updown-5m-1771026600
# Optional: WebSocket port for dashboard (default 8765). Set to 0 to disable.
# DASHBOARD_WS_PORT=8765
# Optional: max concurrent open positions (default 999 = effectively no limit).
# MAX_OPEN_POSITIONS=999
# Optional: session persistence file path (default data/session.json).
# SESSION_FILE=data/session.json
# Optional: max profit % before treating as suspicious data error (default 50).
# MAX_PROFIT_PERCENT_BEFORE_SUSPICIOUS=50
# Optional: min ms between trades (default 2000).
# MIN_TIME_BETWEEN_TRADES_MS=2000
# Optional: if true, only take pure arbitrage (yes+no < $1); skip directional.
# PURE_ARB_ONLY=false
# If true, only take directional trades (exchange vs Polymarket); skip pure arb. Default true for directional-only demo.
# DIRECTIONAL_ONLY=true
# Stricter entry: only trade when opportunity is strong (defaults below = fewer, higher-quality trades).
# MIN_EDGE_PERCENT=10
# EXCHANGE_SIGNAL_THRESHOLD_PERCENT=0.03
# MIN_EXCHANGE_MOVE_PERCENT=0.15
# MIN_SECONDS_REMAINING_IN_WINDOW=120
# Demo starting balance in dry run (default 1000). Max 5% per trade of current balance.
# DEMO_STARTING_BALANCE=1000
