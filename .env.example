# Polymarket Configuration
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYGON_PRIVATE_KEY=your_polygon_wallet_private_key_here
POLYGON_RPC_URL=https://polygon.llamarpc.com

# Exchange API Keys (read-only for price feeds)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Bot Configuration
MAX_POSITION_SIZE_USDC=100
POLL_INTERVAL_MS=1000
DRY_RUN=true
# Optional: require live Polymarket market data and refuse simulation fallback.
# FORCE_REAL_DATA=true
# Optional: initial BTC 5-min event slug to track (and subsequent windows). Example: btc-updown-5m-1771026600
# POLYMARKET_BTC_5M_EVENT_SLUG=btc-updown-5m-1771026600
# Optional: WebSocket port for dashboard (default 8765). Set to 0 to disable.
# DASHBOARD_WS_PORT=8765
# Optional: max concurrent open positions (default 20).
# MAX_OPEN_POSITIONS=50
# Max positions per 5-min window (default 1). Prevents concentrating full portfolio risk in one window.
# MAX_POSITIONS_PER_WINDOW=1
# Optional: max USD exposure in a single 5-min window. Unset = no cap.
# MAX_EXPOSURE_PER_WINDOW_USDC=200
# Optional: max fraction of current balance (0..1) per window, e.g. 0.25 = 25%. Unset = no cap.
# MAX_EXPOSURE_PER_WINDOW_FRACTION=0.25
# Optional: session persistence file path (default data/session.json).
# SESSION_FILE=data/session.json
# Optional: min ms between trades (default 1000).
# MIN_TIME_BETWEEN_TRADES_MS=1000
# Optional: max trades per minute (default 50). Rate limit.
# MAX_TRADES_PER_MINUTE=50
# If true, only take directional trades (exchange vs Polymarket). Default true.
# DIRECTIONAL_ONLY=true
# If true, do not open new directional trades (endgame arb still runs). Default false.
# PAUSE_DIRECTIONAL_TRADING=false
# Conservative high-quality directional (fewer trades, higher edge/win prob, then size up):
# MIN_EDGE_PERCENT=14
# EXCHANGE_SIGNAL_THRESHOLD_PERCENT=0.03
# MIN_EXCHANGE_MOVE_PERCENT=0.07
# MIN_SECONDS_REMAINING_IN_WINDOW=45
# MAX_SECONDS_REMAINING_IN_WINDOW=210
# MIN_WIN_PROBABILITY=0.60
# MIN_ASK_SIZE_SHARES=50
# KELLY_MULTIPLIER=0.55
# More trades (looser): MIN_EDGE_PERCENT=5, MIN_WIN_PROBABILITY=0.52, MIN_EXCHANGE_MOVE_PERCENT=0.03, KELLY_MULTIPLIER=0.4
# Demo starting balance in dry run (default 1000).
# DEMO_STARTING_BALANCE=1000

# Optional: Chainlink Data Streams (same feed as Polymarket: https://data.chain.link/streams/btc-usd-cexprice-streams).
# When set, window start/end BTC prices use this feed for resolution alignment.
# CHAINLINK_DS_API_KEY=your_chainlink_data_streams_api_key_uuid
# CHAINLINK_DS_API_SECRET=your_chainlink_data_streams_api_secret
# Optional: BTC/USD feed ID (hex). If unset, uses the RefPrice/CEX stream feed ID.
# CHAINLINK_BTC_USD_FEED_ID=0x0003...

# Endgame arb: buy near-certain side (95–99¢) close to resolution.
# ENDGAME_ARB_ENABLED=true
# ENDGAME_MAX_SECONDS_REMAINING=60
# ENDGAME_MIN_SECONDS_REMAINING=5
# ENDGAME_MIN_PROBABILITY=0.85
# ENDGAME_MAX_ASK=0.98